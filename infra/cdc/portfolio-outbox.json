{
  "connector.class": "io.debezium.connector.mysql.MySqlConnector",
  "tasks.max": "1",
  "database.hostname": "mysql",
  "database.port": "3306",
  "database.user": "sentinel_cdc",
  "database.password": "${file:/run/secrets/cdc-reader.properties:password}",
  "database.server.id": "223346",
  "database.include.list": "sentinel_portfolio",
  "table.include.list": "sentinel_portfolio.outbox_events",
  "topic.prefix": "sentinel-custom-reports-cdc-v1",
  "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
  "schema.history.internal.kafka.topic": "sentinel-custom-reports-schema-history-v1",
  "schema.history.internal.store.only.captured.tables.ddl": "true",
  "schema.history.internal.store.only.captured.databases.ddl": "true",
  "snapshot.mode": "initial",
  "snapshot.locking.mode": "none",
  "include.schema.changes": "false",
  "tombstones.on.delete": "false",
  "poll.interval.ms": "200",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "predicates": "isOutbox",
  "predicates.isOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.isOutbox.pattern": "sentinel-custom-reports-cdc-v1\\.sentinel_portfolio\\.outbox_events",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.predicate": "isOutbox",
  "transforms.outbox.route.by.field": "destination",
  "transforms.outbox.route.topic.regex": "(?<routedByValue>sentinel\\.custom-report\\.(?:request|status|dlt)\\.v1)",
  "transforms.outbox.route.topic.replacement": "${routedByValue}",
  "transforms.outbox.table.field.event.id": "id",
  "transforms.outbox.table.field.event.key": "aggregateid",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.table.op.invalid.behavior": "fatal",
  "transforms.outbox.table.fields.additional.placement": "original_event_id:header:originalEventId",
  "transforms.outbox.table.fields.additional.error.on.missing": "false"
}
